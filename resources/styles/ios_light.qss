QWidget {
  font-family: "SF Pro Text", "PingFang SC", "Segoe UI", "Microsoft YaHei";
  font-size: 14px;
  color: #e5e7eb;
}

#MainCard {
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.20);
  background: rgba(18, 24, 33, 0.66);
}

#MainStack {
  background: transparent;
  border: none;
}

#SegmentedNav QPushButton {
  min-height: 44px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  background: rgba(17, 23, 31, 0.72);
  color: #e2e8f0;
  font-weight: 600;
}

#SegmentedNav QPushButton:hover {
  background: rgba(26, 33, 43, 0.84);
}

#SegmentedNav QPushButton:checked {
  background: rgba(56, 72, 92, 0.90);
  border: 1px solid rgba(148, 163, 184, 0.50);
  color: #f8fafc;
}

#OpsPane, #LogPane, #PreviewPane {
  background: transparent;
}

#OpsPanel,
QScrollArea,
QScrollArea > QWidget > QWidget {
  background: transparent;
  border: none;
}

#PanelGroup {
  background: rgba(15, 20, 28, 0.70);
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
}

QLabel#GroupTitle {
  font-weight: 700;
  color: #f1f5f9;
  padding-bottom: 4px;
}

QLineEdit, QComboBox, QTextEdit {
  background: rgba(9, 14, 21, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.26);
  border-radius: 8px;
  color: #e5e7eb;
  padding: 6px 8px;
}

QComboBox QAbstractItemView {
  background: rgba(9, 14, 21, 0.98);
  color: #e5e7eb;
  border: 1px solid rgba(148, 163, 184, 0.36);
  selection-background-color: rgba(71, 85, 105, 0.92);
  selection-color: #f8fafc;
  outline: 0;
}

QTextEdit {
  selection-background-color: rgba(100, 116, 139, 0.46);
}

QPushButton {
  background: rgba(30, 41, 59, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.30);
  border-radius: 8px;
  padding: 6px 12px;
  color: #f8fafc;
}

QPushButton:hover {
  background: rgba(51, 65, 85, 0.92);
}

QPushButton:pressed {
  background: rgba(15, 23, 42, 0.96);
}

QPushButton:disabled {
  background: rgba(71, 85, 105, 0.45);
  color: rgba(226, 232, 240, 0.70);
}

QProgressBar {
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 8px;
  background: rgba(2, 6, 12, 0.78);
  color: #e2e8f0;
  text-align: center;
}

QProgressBar::chunk {
  border-radius: 7px;
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 rgba(100, 116, 139, 0.95),
    stop: 1 rgba(148, 163, 184, 0.95)
  );
}

QSlider::groove:horizontal {
  height: 6px;
  border-radius: 3px;
  background: rgba(100, 116, 139, 0.45);
}

QSlider::handle:horizontal {
  width: 14px;
  margin: -5px 0;
  border-radius: 7px;
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(148, 163, 184, 0.8);
}

QCheckBox#AutoUnloadCheck::indicator {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.55);
  background: rgba(15, 23, 42, 0.82);
}

QCheckBox#AutoUnloadCheck::indicator:hover {
  border: 1px solid rgba(148, 163, 184, 0.85);
  background: rgba(30, 41, 59, 0.92);
}

QCheckBox#AutoUnloadCheck::indicator:checked {
  border: 1px solid rgba(16, 185, 129, 0.95);
  background: rgba(16, 185, 129, 0.30);
}

QSplitter::handle {
  background: rgba(148, 163, 184, 0.20);
}

QGroupBox {
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 10px;
  margin-top: 10px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
  color: #e2e8f0;
}

QMessageBox {
  background: #f3f4f6;
  color: #0f172a;
}

QMessageBox QLabel {
  color: #0f172a;
  background: transparent;
}

QMessageBox QPushButton {
  min-width: 84px;
  color: #0f172a;
  background: #e5e7eb;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 6px 10px;
}

QMessageBox QPushButton:hover {
  background: #dbe0e8;
}
